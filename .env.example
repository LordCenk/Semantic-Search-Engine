# Environment Variables for Semantic Search Engine
# Copy this file to .env or export the variables in your deployment environment.

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=semantic_search
DB_USER=root
DB_PASSWORD=rootpassword

# Active Spring Profile (e.g. dev, prod, test)
# Use 'dev' or 'mysql' for local development with MySQL, or leave default with H2/MySQL
SPRING_PROFILES_ACTIVE=dev

# Embedding Provider Configuration
# Supported options: 'fake' (default, offline deterministic vectors), 'openai', 'ollama', 'rest'
EMBEDDING_PROVIDER=fake
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# HNSW Graph Hyperparameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=32
